{
  "name": "aletheia",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/write-build-env.mjs && npm run scripture:coverage:manifest && npm run scripture:coverage:validate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scripture:coverage:manifest": "node scripts/generate-scripture-coverage-manifest.mjs",
    "scripture:coverage:validate": "node scripts/validate-scripture-coverage.mjs",
    "scripture:book-names": "node scripts/generate-scripture-book-names.mjs",
    "scripture:chunks": "node scripts/generate-full-scripture-chunks.mjs",
    "scripture:import:ebible": "node scripts/import-ebible-vpl.mjs",
    "quality:scripture": "node scripts/scripture-quality-regression.mjs",
    "quality:scripture:strict": "QUALITY_MAX_FALLBACK_RATE=0.25 QUALITY_MIN_CITATION_RATIO=0.8 node scripts/scripture-quality-regression.mjs",
    "mobile:assets": "npx @capacitor/assets generate --assetPath assets --iconBackgroundColor '#eef2ef' --iconBackgroundColorDark '#0e1514' --splashBackgroundColor '#eef2ef' --splashBackgroundColorDark '#0e1514' --logoSplashScale 0.28 --ios --android",
    "mobile:sync": "cap sync",
    "mobile:bundle:android": "cd android && ./gradlew bundleRelease",
    "mobile:archive:ios": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -archivePath build/App.xcarchive archive",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "translations:analyze": "npx ts-node scripts/analyze-translations.ts",
    "translations:audit": "npx ts-node scripts/analyze-translations.ts --strict",
    "translations:strict": "node scripts/check-strict-locales.mjs",
    "ui:regression": "node scripts/ui-regression.mjs",
    "ui:i18n": "node scripts/ui-i18n-regression.mjs",
    "notify:daily": "node scripts/send-daily-notifications.mjs",
    "push:keys": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@types/nodemailer": "^8.0.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.7",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "openai": "^6.38.0",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.54.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
